{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "DutchMate Design System",
  "version": "1.0.0",
  "color": {
    "brandOrange": { "$type": "color", "$value": "#FF6B00" },
    "brandOrangeDeep": { "$type": "color", "$value": "#9C3900" },
    "inkStrong": { "$type": "color", "$value": "#1B1714" },
    "inkMuted": { "$type": "color", "$value": "#675C54" },
    "paper": { "$type": "color", "$value": "#FFF9F2" },
    "paperRaised": { "$type": "color", "$value": "#FFFFFF" },
    "paperSoft": { "$type": "color", "$value": "#F8EEE4" },
    "line": { "$type": "color", "$value": "#D8CABE" },
    "success": { "$type": "color", "$value": "#2F6B4F" },
    "warning": { "$type": "color", "$value": "#7A5100" },
    "danger": { "$type": "color", "$value": "#9D2A2A" },
    "info": { "$type": "color", "$value": "#275C7D" }
  },
  "fontFamily": {
    "ui": {
      "$type": "fontFamily",
      "$value": ["Nunito Sans", "ui-rounded", "Arial Rounded MT Bold", "system-ui", "sans-serif"]
    },
    "reading": {
      "$type": "fontFamily",
      "$value": ["Noto Sans", "Inter", "system-ui", "sans-serif"]
    },
    "telugu": {
      "$type": "fontFamily",
      "$value": ["Noto Sans Telugu", "Nirmala UI", "sans-serif"]
    }
  },
  "fontSize": {
    "display": { "$type": "dimension", "$value": "48px" },
    "h1": { "$type": "dimension", "$value": "32px" },
    "h2": { "$type": "dimension", "$value": "22px" },
    "body": { "$type": "dimension", "$value": "16px" },
    "label": { "$type": "dimension", "$value": "12px" },
    "small": { "$type": "dimension", "$value": "11px" }
  },
  "lineHeight": {
    "display": { "$type": "number", "$value": 1.0417 },
    "h1": { "$type": "number", "$value": 1.125 },
    "h2": { "$type": "number", "$value": 1.2727 },
    "body": { "$type": "number", "$value": 1.5 },
    "telugu": { "$type": "number", "$value": 1.625 }
  },
  "space": {
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "24px" },
    "6": { "$type": "dimension", "$value": "32px" },
    "7": { "$type": "dimension", "$value": "48px" }
  },
  "radius": {
    "control": { "$type": "dimension", "$value": "10px" },
    "card": { "$type": "dimension", "$value": "16px" },
    "panel": { "$type": "dimension", "$value": "24px" },
    "round": { "$type": "dimension", "$value": "999px" }
  },
  "size": {
    "targetMin": { "$type": "dimension", "$value": "44px" },
    "popupWidth": { "$type": "dimension", "$value": "390px" },
    "popupHeight": { "$type": "dimension", "$value": "600px" }
  },
  "shadow": {
    "low": {
      "$type": "shadow",
      "$value": [
        { "color": "#1B171414", "offsetX": "0px", "offsetY": "1px", "blur": "2px", "spread": "0px" },
        { "color": "#1B17140F", "offsetX": "0px", "offsetY": "5px", "blur": "16px", "spread": "0px" }
      ]
    },
    "high": {
      "$type": "shadow",
      "$value": {
        "color": "#1B17142E",
        "offsetX": "0px",
        "offsetY": "18px",
        "blur": "60px",
        "spread": "0px"
      }
    }
  },
  "motion": {
    "fast": { "$type": "duration", "$value": "120ms" },
    "standard": { "$type": "duration", "$value": "180ms" },
    "deliberate": { "$type": "duration", "$value": "260ms" }
  },
  "learningState": {
    "new": { "$type": "string", "$value": "Encountered, not yet tested" },
    "learning": { "$type": "string", "$value": "Needs supported retrieval" },
    "familiar": { "$type": "string", "$value": "Recognised in recent encounters" },
    "secure": { "$type": "string", "$value": "Repeated recall evidence over time" }
  }
}
